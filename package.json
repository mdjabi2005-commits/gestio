{
  "name": "gestio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:web": "vite --config vite.config.ts",
    "build": "tsc && vite build --config vite.config.ts",
    "start": "node dist/index.js",
    "lint": "npm run typecheck && bash -n scripts/backup.sh scripts/install-backup-cron.sh",
    "typecheck": "tsc --noEmit",
    "test": "unset NODE_TEST_CONTEXT; node --test --import tsx --test-reporter=spec \"src/**/*.test.ts\"",
    "backup": "scripts/backup.sh"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "argon2": "^0.45.1",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^12.11.1",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
