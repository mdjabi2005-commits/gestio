GESTIO_DB_KEY=change-me-32-random-characters-minimum
GESTIO_DB_PATH=data/gestio.db
GESTIO_HOST=127.0.0.1
GESTIO_PORT=3443
# Noms ou alias séparés par des virgules, tels qu'ils apparaissent dans les libellés bancaires (garder la valeur réelle hors du dépôt).
# Vide ou absent : un virement personnel sans jambe miroir redevient « externe probable » et l'oracle de qualification est ignoré.
GESTIO_PERSONAL_NAMES="Votre Prénom Votre Nom,Autre alias personnel"
ENABLE_BANKING_URL=https://api.enablebanking.com
ENABLE_BANKING_APP_ID=active-application-kid
ENABLE_BANKING_KEY_PATH=/absolute/path/to/private-key.pem
ENABLE_BANKING_REDIRECT_URL=https://localhost:3443/
